# URL del servidor FleetPulse (API HTTP/SSE, internal/api en el servidor Go).
NEXT_PUBLIC_API_URL=http://localhost:8080

# Solo si el servidor se arrancó con --dashboard-token / FLEETPULSE_DASHBOARD_TOKEN.
# Queda embebido en el bundle del navegador: no es un secreto si la app se expone
# fuera de una LAN de confianza (ver README, sección de seguridad).
NEXT_PUBLIC_API_TOKEN=
